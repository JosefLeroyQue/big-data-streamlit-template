# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- WeatherAPI (https://www.weatherapi.com/ - free key) ---
WEATHER_API_KEY=8411c1b95f614bc3b95104406262510
WEATHER_LOCATION=Manila
# Seconds between API calls. WeatherAPI refreshes data roughly every 15 minutes,
# so 60 is plenty and keeps you far below the free-tier quota.
POLL_SECONDS=60

# --- Kafka ---
KAFKA_TOPIC=streaming-data
# "latest" = only new messages; "earliest" = replay the topic on first start.
KAFKA_STARTING_OFFSETS=latest

# --- MongoDB (processor and dashboard must use the same values) ---
MONGODB_DATABASE=weather_db
MONGODB_COLLECTION=weather_data

# --- Dashboard ---
DASHBOARD_TIMEZONE=Asia/Manila
DASHBOARD_REFRESH_SECONDS=20
# true = show synthetic demo data instead of MongoDB (UI development only)
DASHBOARD_DEMO_MODE=false

# --- Only for running scripts directly on your host (outside Docker) ---
# Inside Docker, Compose sets these to kafka:29092 and mongodb://mongodb:27017.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# MONGODB_URI=mongodb://localhost:27017
